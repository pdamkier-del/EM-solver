{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EM1 backend response 1.0",
  "type": "object",
  "required": ["schema_version", "status", "interpretation", "solution", "missing", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["not_solved", "ready", "partial", "verified_with_assumptions", "verified"]},
    "interpretation": {"type": ["object", "null"], "properties": {"model": {"type": "object"}, "fields": {"type": "object"}, "ready": {"type": "boolean"}}, "required": ["model", "fields", "ready"]},
    "solution": {"type": ["object", "null"], "properties": {"method": {"type": "string"}, "reasoning": {"type": "string"}, "equations_latex": {"type": "array", "items": {"type": "string"}}, "steps": {"type": "array"}, "results": {"type": "object"}, "numerical": {"type": "object"}, "checks": {"type": "array"}, "warnings": {"type": "array"}, "physical_model_rejected": {"type": "boolean"}}, "required": ["method", "reasoning", "equations_latex", "steps", "results", "numerical", "checks", "warnings", "physical_model_rejected"]},
    "missing": {"type": "array", "items": {"type": "object", "required": ["field", "status", "message", "options"]}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
